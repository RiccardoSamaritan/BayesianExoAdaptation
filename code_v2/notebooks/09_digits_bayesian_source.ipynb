    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"fff3f0b9\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Caricamento del source model verificato + domini target\\n\",\n",
    "    \"\\n\",\n",
    "    \"`src/digits_verify.py` ha già confermato che questo checkpoint, ricaricato\\n\",\n",
    "    \"da zero, riproduce esattamente l'accuracy riportata a fine training (PASS\\n\",\n",
    "    \"su SVHN test, MNIST test e USPS test). Qui viene ricaricato allo stesso\\n\",\n",
    "    \"modo, insieme a MNIST e USPS come dataset separati per le sezioni\\n\",\n",
    "    \"successive.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"303eeabf\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:40:55.999676Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:40:55.999563Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:40:56.483472Z\",\n",
    "     \"shell.execute_reply\": \"2026-08-27T09:40:56.483030Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:21:10.573919Z\",\n",
    "     \"start_time\": \"2026-08-29T16:21:08.486291Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"model = SmallCNN32(n_classes=ckpt[\\\"n_classes\\\"], feature_dim=ckpt[\\\"feature_dim\\\"])\\n\",\n",
    "    \"model.load_state_dict(ckpt[\\\"state_dict\\\"])\\n\",\n",
    "    \"model.eval()\\n\",\n",
    "    \"print(f\\\"model.training = {model.training} (deve essere False)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"target_data = {}\\n\",\n",
    "    \"for domain in TARGET_DOMAINS:\\n\",\n",
    "    \"    X_t, y_t = load_domain(domain, \\\"test\\\", mean, std)\\n\",\n",
    "    \"    target_data[domain] = (X_t, y_t)\\n\",\n",
    "    \"    print(f\\\"dominio target '{domain}': {X_t.shape[0]} immagini (test split, \\\"\\n\",\n",
    "    \"          f\\\"normalizzate con le statistiche di {SOURCE_DOMAIN}-train)\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"model.training = False (deve essere False)\\n\",\n",
    "      \"dominio target 'mnist': 10000 immagini (test split, normalizzate con le statistiche di svhn-train)\\n\",\n",
    "      \"dominio target 'usps': 2007 immagini (test split, normalizzate con le statistiche di svhn-train)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"8e41cebf\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Fit di Laplace sull'ultimo layer\\n\",\n",
    "    \"\\n\",\n",
    "    \"`tau_prior = weight_decay * N_source`: `weight_decay` è quello che\\n\",\n",
    "    \"`src/digits_train.py` ha effettivamente passato ad `AdamW` (letto dal\\n\",\n",
    "    \"checkpoint, non assunto); `N_source = ckpt[\\\"n_source_train\\\"]` è la\\n\",\n",
    "    \"dimensione dello split di training interno che l'ottimizzatore ha\\n\",\n",
    "    \"effettivamente visto (esclude lo split di validazione per l'early\\n\",\n",
    "    \"stopping).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Il fit gira sull'**intero** SVHN train (nessun sottocampionamento):\\n\",\n",
    "    \"`weight_space_hessian` (`laplace_core.py`) costruisce l'Hessiana blocco per\\n\",\n",
    "    \"blocco via BLAS (`K²` blocchi `D×D`), senza mai materializzare un tensore\\n\",\n",
    "    \"`(N,Dp,Dp)` -- a differenza dell'implementazione usata in una versione\\n\",\n",
    "    \"precedente di questo esperimento, che per lo stesso motivo doveva\\n\",\n",
    "    \"sottocampionare SVHN train a poche migliaia di immagini.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"ad0977e3\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:40:56.484930Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:40:56.484846Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:41:10.759746Z\",\n",
    "     \"shell.execute_reply\": \"2026-08-27T09:41:10.758993Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:21:50.436430Z\",\n",
    "     \"start_time\": \"2026-08-29T16:21:10.624030Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"tau_prior = WEIGHT_DECAY * N_SOURCE_TRAIN\\n\",\n",
    "    \"print(f\\\"tau_prior = weight_decay * N_source = {WEIGHT_DECAY} * {N_SOURCE_TRAIN} = {tau_prior:.3f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_svhn_train, y_svhn_train = load_domain(SOURCE_DOMAIN, \\\"train\\\", mean, std)\\n\",\n",
    "    \"print(f\\\"{SOURCE_DOMAIN} train (pool designato per il fit): {X_svhn_train.shape[0]} immagini\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_loader = DataLoader(TensorDataset(X_svhn_train, y_svhn_train), batch_size=256, shuffle=False)\\n\",\n",
    "    \"Phi, y_np, _ = extract(model, train_loader, device=\\\"cpu\\\")\\n\",\n",
    "    \"Phi_aug = augment(Phi)\\n\",\n",
    "    \"W_aug = head_weights(model)\\n\",\n",
    "    \"print(f\\\"Phi: {Phi.shape}  Phi_aug: {Phi_aug.shape}  W_aug: {W_aug.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"laplace = LastLayerLaplace.fit(W_aug, Phi_aug, tau_prior=tau_prior)\\n\",\n",
    "    \"print(f\\\"\\\\nLaplace fit: K={laplace.K}  Dp={laplace.Dp}  cov shape={laplace.cov.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"map_preds = (Phi_aug @ W_aug.T).argmax(axis=1)\\n\",\n",
    "    \"map_acc = (map_preds == y_np).mean()\\n\",\n",
    "    \"print(f\\\"sanity check -- MAP accuracy sulle stesse {len(y_np)} feature di training: {100 * map_acc:.2f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"MODELS_DIR = CHECKPOINT_PATH.parent\\n\",\n",
    "    \"np.savez(MODELS_DIR / \\\"svhn_laplace.npz\\\", theta_map=laplace.theta_map, cov=laplace.cov,\\n\",\n",
    "    \"        K=laplace.K, Dp=laplace.Dp, tau_prior=tau_prior, source_mean=mean, source_std=std)\\n\",\n",
    "    \"print(f\\\"\\\\nsalvato {MODELS_DIR / 'svhn_laplace.npz'}\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"tau_prior = weight_decay * N_source = 0.001 * 65932 = 65.932\\n\",\n",
    "      \"svhn train (pool designato per il fit): 73257 immagini\\n\",\n",
    "      \"Phi: (73257, 128)  Phi_aug: (73257, 129)  W_aug: (10, 129)\\n\",\n",
    "      \"\\n\",\n",
    "      \"Laplace fit: K=10  Dp=129  cov shape=(1290, 1290)\\n\",\n",
    "      \"sanity check -- MAP accuracy sulle stesse 73257 feature di training: 94.35%\\n\",\n",
    "      \"\\n\",\n",
    "      \"salvato C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\models\\\\source_svhn\\\\svhn_laplace.npz\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"4e0eb175\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Confronto pulito source vs. target\\n\",\n",
    "    \"\\n\",\n",
    "    \"A differenza di una versione precedente di questo esperimento (dove il\\n\",\n",
    "    \"checkpoint source arrivava già pre-addestrato, senza uno split\\n\",\n",
    "    \"disponibile, e ogni valutazione \\\"source\\\" era in realtà sui punti di\\n\",\n",
    "    \"training), qui `svhn_train.npz` (usato per il fit sopra) e `svhn_test.npz`\\n\",\n",
    "    \"(usato più avanti come baseline source) sono due file disgiunti: la\\n\",\n",
    "    \"baseline source nei prossimi notebook è quindi pulita, su dati mai visti\\n\",\n",
    "    \"né dal training né dal fit -- confermato di seguito controllando\\n\",\n",
    "    \"esplicitamente quale split è stato usato dove.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"d072d118\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:41:10.761422Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:41:10.761292Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:41:12.074219Z\",\n",
    "     \"shell.execute_reply\": \"2026-08-27T09:41:12.073686Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:21:54.861117Z\",\n",
    "     \"start_time\": \"2026-08-29T16:21:50.473498Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"X_svhn_test, y_svhn_test = load_domain(SOURCE_DOMAIN, \\\"test\\\", mean, std)\\n\",\n",
    "    \"print(f\\\"fit (sopra):              digits/svhn_train.npz  ({X_svhn_train.shape[0]} immagini)\\\")\\n\",\n",
    "    \"print(f\\\"baseline source (dopo):   digits/svhn_test.npz   ({X_svhn_test.shape[0]} immagini)\\\")\\n\",\n",
    "    \"print(\\\"file disgiunti, caricati indipendentemente -- non possono sovrapporsi\\\")\"\n",
