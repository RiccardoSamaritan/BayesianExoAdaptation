    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\models\\\\source_svhn\\\\model.pt non trovato -- lancio il training (code_v2/src/digits_train.py)...\\n\",\n",
    "      \"Device: cuda\\n\",\n",
    "      \"Computing svhn (source) normalization stats from its training split...\\n\",\n",
    "      \"  mean=0.4453  std=0.1970\\n\",\n",
    "      \"svhn train: 73257 images   svhn test: 26032 images\\n\",\n",
    "      \"Internal split (svhn train only): 65932 train / 7325 val (val_fraction=0.1, seed=2019) -- svhn test untouched until the final report\\n\",\n",
    "      \"Training configuration:\\n\",\n",
    "      \"  optimizer=AdamW  lr=0.001  weight_decay=0.001\\n\",\n",
    "      \"  batch_size=128  max_epochs=30  patience=5\\n\",\n",
    "      \"epoch   1/30: train_loss=0.5648 train_acc=0.8415  val_loss=0.5799 val_acc=0.8337\\n\",\n",
    "      \"epoch   2/30: train_loss=0.4430 train_acc=0.8742  val_loss=0.4736 val_acc=0.8616\\n\",\n",
    "      \"epoch   3/30: train_loss=0.3794 train_acc=0.8914  val_loss=0.4294 val_acc=0.8740\\n\",\n",
    "      \"epoch   4/30: train_loss=0.3388 train_acc=0.9051  val_loss=0.4035 val_acc=0.8774\\n\",\n",
    "      \"epoch   5/30: train_loss=0.2987 train_acc=0.9133  val_loss=0.3820 val_acc=0.8830\\n\",\n",
    "      \"epoch   6/30: train_loss=0.2644 train_acc=0.9240  val_loss=0.3668 val_acc=0.8904\\n\",\n",
    "      \"epoch   7/30: train_loss=0.2548 train_acc=0.9259  val_loss=0.3914 val_acc=0.8829\\n\",\n",
    "      \"epoch   8/30: train_loss=0.2120 train_acc=0.9397  val_loss=0.3608 val_acc=0.8915\\n\",\n",
    "      \"epoch   9/30: train_loss=0.1818 train_acc=0.9487  val_loss=0.3581 val_acc=0.8965\\n\",\n",
    "      \"epoch  10/30: train_loss=0.1941 train_acc=0.9414  val_loss=0.3984 val_acc=0.8860\\n\",\n",
    "      \"epoch  11/30: train_loss=0.1585 train_acc=0.9556  val_loss=0.3776 val_acc=0.8931\\n\",\n",
    "      \"epoch  12/30: train_loss=0.1471 train_acc=0.9567  val_loss=0.4073 val_acc=0.8866\\n\",\n",
    "      \"epoch  13/30: train_loss=0.1191 train_acc=0.9674  val_loss=0.4066 val_acc=0.8904\\n\",\n",
    "      \"epoch  14/30: train_loss=0.1114 train_acc=0.9696  val_loss=0.4207 val_acc=0.8893\\n\",\n",
    "      \"Early stopping at epoch 14 (patience=5, best val_loss=0.3581)\\n\",\n",
    "      \"Evaluating (no adaptation) on ['mnist', 'usps'], normalized with svhn-train stats (mean=0.4453, std=0.1970)...\\n\",\n",
    "      \"  mnist test accuracy (no adaptation): 60.55%\\n\",\n",
    "      \"  usps test accuracy (no adaptation): 61.34%\\n\",\n",
    "      \"\\n\",\n",
    "      \"Saved checkpoint to C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\models\\\\source_svhn\\\\model.pt\\n\",\n",
    "      \"\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"SUMMARY\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"Total training time: 59.2 sec (1.0 min)\\n\",\n",
    "      \"svhn (source) test accuracy:  88.08%\\n\",\n",
    "      \"mnist test accuracy (no adaptation): 60.55%\\n\",\n",
    "      \"usps test accuracy (no adaptation): 61.34%\\n\",\n",
    "      \"checkpoint: C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\models\\\\source_svhn\\\\model.pt\\n\",\n",
    "      \"source_mean=0.4453 source_std=0.1970 weight_decay=0.001 n_source_train=65932\\n\"\n",
    "     ]\n",
