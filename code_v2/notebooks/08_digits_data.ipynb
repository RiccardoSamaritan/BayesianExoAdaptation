    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:13:47.827447Z\",\n",
    "     \"start_time\": \"2026-08-29T16:13:47.774286Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import ssl\\n\",\n",
    "    \"import shutil\\n\",\n",
    "    \"import urllib.request\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def download_with_unverified_ssl(url: str, dest: Path):\\n\",\n",
    "    \"    \\\"\\\"\\\"Fallback for environments where the system CA bundle does not trust the source site.\\\"\\\"\\\"\\n\",\n",
    "    \"    with urllib.request.urlopen(url, context=ssl._create_unverified_context()) as resp, open(dest, \\\"wb\\\") as f:\\n\",\n",
    "    \"        shutil.copyfileobj(resp, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"for split_name, train_flag in [(\\\"train\\\", True), (\\\"test\\\", False)]:\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        shape = ensure_split(datasets.USPS, dict(root=str(RAW_DIR), train=train_flag, download=True),\\n\",\n",
    "    \"                             f\\\"usps_{split_name}\\\")\\n\",\n",
    "    \"    except Exception as exc:\\n\",\n",
    "    \"        if \\\"CERTIFICATE_VERIFY_FAILED\\\" not in str(exc) and \\\"URLError\\\" not in str(type(exc)):\\n\",\n",
    "    \"            raise\\n\",\n",
    "    \"        split = \\\"train\\\" if train_flag else \\\"test\\\"\\n\",\n",
    "    \"        url, filename, _ = datasets.USPS.split_list[split]\\n\",\n",
    "    \"        target_path = RAW_DIR / filename\\n\",\n",
    "    \"        if not target_path.exists():\\n\",\n",
    "    \"            print(f\\\"usps_{split_name}: SSL certificate check failed, retrying download without verification\\\")\\n\",\n",
    "    \"            download_with_unverified_ssl(url, target_path)\\n\",\n",
    "    \"        shape = ensure_split(datasets.USPS, dict(root=str(RAW_DIR), train=train_flag, download=False),\\n\",\n",
    "    \"                             f\\\"usps_{split_name}\\\")\\n\",\n",
    "    \"    print(f\\\"usps_{split_name}: X{shape[0]} y{shape[1]}\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"usps_train: C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\data\\\\digits\\\\usps_train.npz esiste gi? -- download e conversione saltati\\n\",\n",
    "      \"usps_train: X(7291, 16, 16) y(7291,)\\n\",\n",
    "      \"usps_test: C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\data\\\\digits\\\\usps_test.npz esiste gi? -- download e conversione saltati\\n\",\n",
    "      \"usps_test: X(2007, 16, 16) y(2007,)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"b7797f40\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## SVHN (32x32 RGB, 10 classi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"`ufldl.stanford.edu` (host di SVHN) può bloccarsi a metà download (HTTP\\n\",\n",
    "    \"semplice, nessun timeout nel downloader di `torchvision`). Se la cella\\n\",\n",
    "    \"sotto resta ferma per più di 1-2 minuti, interrompila e riprova il file\\n\",\n",
    "    \"`.mat` bloccato con un retry con ripresa, es. per `train_32x32.mat`\\n\",\n",
    "    \"(ripetere per `test_32x32.mat`, dimensioni attese 182.040.794 /\\n\",\n",
    "    \"64.275.384 byte):\\n\",\n",
    "    \"\\n\",\n",
    "    \"```bash\\n\",\n",
    "    \"for i in $(seq 1 15); do\\n\",\n",
    "    \"  curl -fSL -C - --connect-timeout 15 --max-time 200 --speed-time 20 --speed-limit 1000 \\\\\\n\",\n",
    "    \"    -o data/digits/raw/train_32x32.mat \\\\\\n\",\n",
    "    \"    \\\"http://ufldl.stanford.edu/housenumbers/train_32x32.mat\\\" && break\\n\",\n",
    "    \"done\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"Poi rilancia la cella sotto: `torchvision` troverà il file già scaricato e\\n\",\n",
    "    \"verificato (checksum) e passerà direttamente alla conversione in `.npz`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"b37ce22b\",\n",
    "   \"metadata\": {\n",
