    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Notebook 7 — Dati per l'esperimento digits (MNIST / USPS / SVHN)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Scarica ed espone in formato numpy i tre dataset usati dai notebook 8-11:\\n\",\n",
    "    \"\\n\",\n",
    "    \"- MNIST: 60.000 train + 10.000 test, 28x28 grayscale, 10 classi\\n\",\n",
    "    \"- USPS: ~7.291 train + 2.007 test, 16x16 grayscale, 10 classi\\n\",\n",
    "    \"- SVHN: ~73.257 train + ~26.032 test, 32x32 RGB, 10 classi (label \\\"10\\\"→\\\"0\\\",\\n\",\n",
    "    \"  già gestita internamente da `torchvision.datasets.SVHN`, verificato sotto\\n\",\n",
    "    \"  invece di assunto)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Il preprocessing comune (grayscale, resize a 32x32, normalizzazione sulle\\n\",\n",
    "    \"statistiche del source) avviene più avanti, in `src/digits_data.py` -- qui\\n\",\n",
    "    \"si salva solo la cache grezza convertita in `.npz`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"42e4f781\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Setup\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"ccef2bd0\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:40:24.493961Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:40:24.493752Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:40:26.053165Z\",\n",
    "     \"shell.execute_reply\": \"2026-08-27T09:40:26.052677Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:13:47.497635Z\",\n",
    "     \"start_time\": \"2026-08-29T16:13:47.482227Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"import ssl\\n\",\n",
    "    \"import shutil\\n\",\n",
    "    \"import urllib.request\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"here = Path().resolve()\\n\",\n",
    "    \"for base in [here, *here.parents]:\\n\",\n",
    "    \"    if (base / \\\"code_v2\\\" / \\\"src\\\" / \\\"laplace_core.py\\\").is_file():\\n\",\n",
    "    \"        sys.path.insert(0, str(base)); PROJ = base / \\\"code_v2\\\"; break\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    raise RuntimeError(\\\"cartella 'code_v2/src' non trovata: apri il progetto dalla sua root\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from torchvision import datasets\\n\",\n",
    "    \"\\n\",\n",
    "    \"DATA_DIR = PROJ / \\\"data\\\" / \\\"digits\\\"\\n\",\n",
    "    \"RAW_DIR = DATA_DIR / \\\"raw\\\"\\n\",\n",
    "    \"RAW_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"print(f\\\"PROJ={PROJ}\\\")\\n\",\n",
    "    \"print(f\\\"DATA_DIR={DATA_DIR}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def download_with_unverified_ssl(url: str, dest: Path):\\n\",\n",
    "    \"    \\\"\\\"\\\"Fallback for environments where the system CA bundle does not trust the source site.\\\"\\\"\\\"\\n\",\n",
    "    \"    with urllib.request.urlopen(url, context=ssl._create_unverified_context()) as resp, open(dest, \\\"wb\\\") as f:\\n\",\n",
    "    \"        shutil.copyfileobj(resp, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def dump_split(dataset, out_path, remap_svhn_ten_to_zero: bool = False):\\n\",\n",
    "    \"    X = np.stack([np.array(img) for img, _ in dataset]).astype(np.uint8)\\n\",\n",
    "    \"    y = np.array([label for _, label in dataset], dtype=np.int64)\\n\",\n",
    "    \"    if remap_svhn_ten_to_zero:\\n\",\n",
    "    \"        # torchvision.datasets.SVHN.__init__ rimappa gi? internamente la\\n\",\n",
    "    \"        # label 10 -> 0 (np.place(self.labels, self.labels == 10, 0)) --\\n\",\n",
    "    \"        # verificato leggendo il suo sorgente, non assunto: qui si controlla\\n\",\n",
    "    \"        # che il risultato sia davvero quello atteso, non lo si \\\"corregge\\\".\\n\",\n",
    "    \"        assert not (y == 10).any(), \\\"inattesa label 10 in SVHN dopo il remap interno di torchvision\\\"\\n\",\n",
    "    \"    np.savez_compressed(out_path, X=X, y=y)\\n\",\n",
    "    \"    return X.shape, y.shape\\n\",\n",
    "    \"\\n\",\n",
    "    \"def ensure_split(dataset_cls, split_kwargs, out_name: str, remap_svhn_ten_to_zero: bool = False):\\n\",\n",
    "    \"    \\\"\\\"\\\"Se out_name.npz esiste gi?, salta download e conversione (stampando\\n\",\n",
    "    \"    un avviso) e ritorna le shape lette da l?; altrimenti costruisce il\\n\",\n",
    "    \"    dataset (scarica se serve) e lo converte.\\\"\\\"\\\"\\n\",\n",
    "    \"    out_path = DATA_DIR / f\\\"{out_name}.npz\\\"\\n\",\n",
    "    \"    if out_path.exists():\\n\",\n",
    "    \"        print(f\\\"{out_name}: {out_path} esiste gi? -- download e conversione saltati\\\")\\n\",\n",
    "    \"        d = np.load(out_path)\\n\",\n",
    "    \"        return d[\\\"X\\\"].shape, d[\\\"y\\\"].shape\\n\",\n",
    "    \"    ds = dataset_cls(**split_kwargs)\\n\",\n",
    "    \"    return dump_split(ds, out_path, remap_svhn_ten_to_zero=remap_svhn_ten_to_zero)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"PROJ=C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\n\",\n",
    "      \"DATA_DIR=C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\data\\\\digits\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"8f387c94\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## MNIST (28x28 grayscale, 10 classi)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"f761d96f\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:40:26.054325Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:40:26.054223Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:40:26.197998Z\",\n",
    "     \"shell.execute_reply\": \"2026-08-27T09:40:26.197522Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T16:13:47.754994Z\",\n",
    "     \"start_time\": \"2026-08-29T16:13:47.524218Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"for split_name, train_flag in [(\\\"train\\\", True), (\\\"test\\\", False)]:\\n\",\n",
    "    \"    shape = ensure_split(datasets.MNIST, dict(root=str(RAW_DIR), train=train_flag, download=True),\\n\",\n",
    "    \"                         f\\\"mnist_{split_name}\\\")\\n\",\n",
    "    \"    print(f\\\"mnist_{split_name}: X{shape[0]} y{shape[1]}\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"mnist_train: C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\data\\\\digits\\\\mnist_train.npz esiste gi? -- download e conversione saltati\\n\",\n",
    "      \"mnist_train: X(60000, 28, 28) y(60000,)\\n\",\n",
    "      \"mnist_test: C:\\\\Users\\\\aless\\\\PycharmProjects\\\\BayesianExoAdaptation\\\\code_v2\\\\data\\\\digits\\\\mnist_test.npz esiste gi? -- download e conversione saltati\\n\",\n",
    "      \"mnist_test: X(10000, 28, 28) y(10000,)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
