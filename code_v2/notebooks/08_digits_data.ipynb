    "    \"## USPS (16x16 grayscale, 10 classi)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"62465eec\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-08-27T09:40:26.199192Z\",\n",
    "     \"iopub.status.busy\": \"2026-08-27T09:40:26.199118Z\",\n",
    "     \"iopub.status.idle\": \"2026-08-27T09:40:26.213002Z\",\n",
