    "    \"for split_name in [\\\"train\\\", \\\"test\\\"]:\\n\",\n",
    "    \"    shape = ensure_split(datasets.SVHN, dict(root=str(RAW_DIR), split=split_name, download=True),\\n\",\n",
    "    \"                         f\\\"svhn_{split_name}\\\", remap_svhn_ten_to_zero=True)\\n\",\n",
