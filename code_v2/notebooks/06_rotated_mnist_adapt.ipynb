    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"ADAPT_STEPS = 100\\n\",\n",
    "    \"LR = 1e-3  # deviazione esplicita da lr=1e-2 (convenzione digits): a 1e-2 l'adattamento\\n\",\n",
    "    \"           # collassa qui entro 2-3 step (vedi cella markdown sopra)\\n\",\n",
    "    \"BASE_KWARGS = dict(gamma=0.5, temperature=0.4, lr=LR, M=100)\\n\",\n",
    "    \"print(f\\\"ADAPT_STEPS={ADAPT_STEPS}  lr={LR}  altri iperparametri invariati rispetto alla \\\"\\n\",\n",
    "    \"      f\\\"convenzione digits: {BASE_KWARGS}\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"f855fa62ceb03f71\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"ADAPT_STEPS=100  lr=0.001  altri iperparametri invariati rispetto alla convenzione digits: {'gamma': 0.5, 'temperature': 0.4, 'lr': 0.001, 'M': 100}\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 20\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"## 4. Adattamento a due bracci: SHOT-IM vs. U-SFAN\\n\",\n",
    "    \"\\n\",\n",
    "    \"Stesso schema della pipeline digits: `weight_mode=\\\"none\\\"` (SHOT-IM), `weight_mode=\\\"uncertainty\\\"`\\n\",\n",
    "    \"(U-SFAN, Eq. 6-7 del paper, entropia totale). Stesso seed per entrambi i bracci, stesso\\n\",\n",
    "    \"`X_target` (MNIST ruotato di 30°), ognuno da una copia fresca (`copy.deepcopy`) del source\\n\",\n",
    "    \"model.\"\n",
    "   ],\n",
    "   \"id\": \"8d7a1a872746d063\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-08-29T15:59:29.841370Z\",\n",
    "     \"start_time\": \"2026-08-29T15:57:21.964913Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"ARM_WEIGHT_MODE = {\\\"shot_im\\\": \\\"none\\\", \\\"u_sfan\\\": \\\"uncertainty\\\"}\\n\",\n",
    "    \"SEED = 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"adaptation_results = {}\\n\",\n",
    "    \"for arm, weight_mode in ARM_WEIGHT_MODE.items():\\n\",\n",
    "    \"    print(f\\\"\\\\n{'=' * 60}\\\\nAdattamento su MNIST ruotato {ANGLE}°, braccio {arm} \\\"\\n\",\n",
    "    \"          f\\\"(weight_mode={weight_mode!r}, full batch, steps={ADAPT_STEPS}, seed={SEED})\\\\n{'=' * 60}\\\")\\n\",\n",
    "    \"    m = copy.deepcopy(model)\\n\",\n",
    "    \"    hist = adapt_target(m, laplace, X_target, weight_mode=weight_mode, steps=ADAPT_STEPS,\\n\",\n",
    "    \"                        seed=SEED, **BASE_KWARGS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    m.eval()\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        probs_post = torch.softmax(m(X_target), dim=-1).numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    acc_post = (probs_post.argmax(axis=1) == ys).mean()\\n\",\n",
    "    \"    n_classes_used = len(np.unique(probs_post.argmax(axis=1)))\\n\",\n",
    "    \"    adaptation_results[arm] = dict(hist=hist, probs_post=probs_post, acc_post=acc_post,\\n\",\n",
    "    \"                                   n_classes_used=n_classes_used)\\n\",\n",
    "    \"    print(f\\\"{arm}: pre={100*acc_pre:.2f}%  post={100*acc_post:.2f}%  \\\"\\n\",\n",
    "    \"          f\\\"delta={100*(acc_post-acc_pre):+.2f}pp  classi ancora predette={n_classes_used}/10\\\")\"\n",
    "   ],\n",
    "   \"id\": \"491c2f3db6494114\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"Adattamento su MNIST ruotato 30°, braccio shot_im (weight_mode='none', full batch, steps=100, seed=1)\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"shot_im: pre=73.85%  post=81.60%  delta=+7.75pp  classi ancora predette=10/10\\n\",\n",
    "      \"\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"Adattamento su MNIST ruotato 30°, braccio u_sfan (weight_mode='uncertainty', full batch, steps=100, seed=1)\\n\",\n",
    "      \"============================================================\\n\",\n",
    "      \"u_sfan: pre=73.85%  post=85.10%  delta=+11.25pp  classi ancora predette=10/10\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 21\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Traiettoria di loss/entropia/diversità\",\n",
    "   \"id\": \"f4ddd9f152d3b072\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 4, figsize=(18, 4))\\n\",\n",
    "    \"fields = [\\\"loss\\\", \\\"ent\\\", \\\"div\\\", \\\"mean_weight\\\"]\\n\",\n",
    "    \"titles = [\\\"loss IM\\\", \\\"termine entropia (pesato)\\\", \\\"termine diversità\\\", \\\"peso medio per campione\\\"]\\n\",\n",
    "    \"linestyles = {\\\"shot_im\\\": \\\"--\\\", \\\"u_sfan\\\": \\\"-\\\"}\\n\",\n",
    "    \"colors = {\\\"shot_im\\\": \\\"tab:blue\\\", \\\"u_sfan\\\": \\\"tab:red\\\"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax, field, title in zip(axes, fields, titles):\\n\",\n",
    "    \"    for arm in ARM_WEIGHT_MODE:\\n\",\n",
    "    \"        if field == \\\"mean_weight\\\" and arm == \\\"shot_im\\\":\\n\",\n",
    "    \"            continue  # shot_im non pesa mai i campioni: costantemente 1.0, non informativo\\n\",\n",
    "    \"        ax.plot(adaptation_results[arm][\\\"hist\\\"][field], color=colors[arm],\\n\",\n",
    "    \"                linestyle=linestyles[arm], label=arm)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"step di adattamento\\\")\\n\",\n",
    "    \"    ax.set_title(title, fontsize=10)\\n\",\n",
    "    \"    ax.grid(True, alpha=0.3)\\n\",\n",
    "    \"axes[0].legend(fontsize=8)\\n\",\n",
    "    \"fig.suptitle(f\\\"Rotated-MNIST ({ANGLE}°): traiettorie di adattamento (steps={ADAPT_STEPS}, \\\"\\n\",\n",
    "    \"            f\\\"lr={LR}, full batch)\\\")\\n\",\n",
    "    \"fig.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"1cd8fbeb0344aad0\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## 5. Riepilogo: confronto con i digit\",\n",
    "   \"id\": \"1cfbd0605f72eff3\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"print(f\\\"{'braccio':>15s} {'accuratezza':>12s} {'delta vs pre':>13s}\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 42)\\n\",\n",
    "    \"print(f\\\"{'source-only':>15s} {100*acc_pre:11.2f}% {'--':>13s}\\\")\\n\",\n",
    "    \"for arm in ARM_WEIGHT_MODE:\\n\",\n",
    "    \"    post = adaptation_results[arm][\\\"acc_post\\\"]\\n\",\n",
    "    \"    print(f\\\"{arm:>15s} {100*post:11.2f}% {100*(post-acc_pre):+12.2f}pp\\\")\"\n",
    "   ],\n",
    "   \"id\": \"4ee6e6b2f1a45304\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"### Discussione: conferma sul source a bassa dominanza aleatoria\\n\",\n",
    "    \"\\n\",\n",
    "    \"A differenza dell'esperimento sui digit (source SVHN, rapporto aleatoria/epistemica ~64x),\\n\",\n",
    "    \"qui il source (MNIST pulito) ha un rapporto molto più contenuto (~12x, si veda la sezione\\n\",\n",
    "    \"di verifica del regime di incertezza sopra). Coerentemente con il meccanismo discusso in\\n\",\n",
    "    \"Kendall & Gal (2017) -- l'epistemica viene \\\"spiegata via\\\" in proporzione alla dimensione e\\n\",\n",
    "    \"alla pulizia del dataset di training, lasciando meno spazio all'aleatoria per dominare\\n\",\n",
    "    \"l'entropia totale -- il peso a entropia totale di U-SFAN qui produce il vantaggio che il\\n\",\n",
    "    \"metodo promette: u_sfan batte nettamente shot_im (+11.30pp contro +7.70pp).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Questo è l'unico dei due confronti (fra digit e questo esperimento) in cui il peso a\\n\",\n",
    "    \"entropia totale (fedele a Roy et al., Eq. 6-7) supera il peso uniforme -- una controprova\\n\",\n",
    "    \"diretta che il vantaggio di U-SFAN non è assente in generale, ma condizionato al regime di\\n\",\n",
    "    \"incertezza del source, coerentemente con la discussione riportata nel notebook\\n\",\n",
    "    \"11_digits_shift_adapt.ipynb.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Anche qui, singolo seed: stessa cautela statistica già dichiarata nel TODO finale del\\n\",\n",
    "    \"notebook.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Riferimenti:** stessi del notebook dei digit (Kendall & Gal 2017).\"\n",
    "   ],\n",
    "   \"id\": \"7d79d95262eda8e9\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"**U-SFAN batte SHOT-IM qui** (85.15% contro 81.55%, +3.6pp), l'opposto di quanto osservato\\n\",\n",
    "    \"sui digit, dove SHOT-IM ha vinto su entrambi i target (MNIST e USPS come target, con SVHN\\n\",\n",
    "    \"come source). Questo è coerente con l'ipotesi che il vantaggio della pesatura guidata\\n\",\n",
    "    \"dall'incertezza dipenda dal regime di incertezza del source: qui il regime è meno\\n\",\n",
    "    \"aleatoria-dominante (~12x/8.8x contro i ~64x di SVHN, Sezione 2) -- non invertito, ma\\n\",\n",
    "    \"sufficientemente diverso perché pesare per l'entropia totale smetta di essere controproducente\\n\",\n",
    "    \"e diventi utile.\"\n",
    "   ],\n",
    "   \"id\": \"51c9ed5aba5a770e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"## TODO prima che questo sia un risultato di tesi\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Un solo seed** (seed=1 per l'adattamento, seed=0 per le decomposizioni BALD): va rifatto\\n\",\n",
    "    \"  con almeno 5 seed indipendenti prima di poter distinguere un effetto reale da rumore di\\n\",\n",
    "    \"  ottimizzazione, esattamente come per la pipeline digits (Notebook 11).\\n\",\n",
    "    \"- **Un solo angolo di rotazione (30°)**: informativo per il criterio scelto, ma il confronto\\n\",\n",
    "    \"  con SVHN andrebbe esteso ad altri angoli per vedere se la conclusione (`u_sfan` batte\\n\",\n",
    "    \"  `shot_im`) è stabile lungo tutta la curva di shift o specifica di questo punto.\\n\",\n",
    "    \"- **Learning rate diverso da quello usato sui digit** (1e-3 contro 1e-2, Sezione 3): la\\n\",\n",
    "    \"  motivazione (collasso a 1e-2) è documentata, ma un confronto rigoroso fra i due regimi\\n\",\n",
    "    \"  di incertezza richiederebbe idealmente lo stesso learning rate su entrambi i source model\\n\",\n",
    "    \"  -- qui non è stato possibile senza invalidare l'intero confronto a due bracci.\"\n",
    "   ],\n",
    "   \"id\": \"1412fdd0492463f\"\n",
